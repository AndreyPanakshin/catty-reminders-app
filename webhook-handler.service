[Unit]
Description=GitHub Webhook Handler
After=network.target

[Service]
User=admin
WorkingDirectory=/home/admin/catty-reminders-app
ExecStart=/home/admin/catty-reminders-app/venv/bin/python /home/admin/catty-reminders-app/webhook_handler.py
Restart=always
Environment=PATH=/home/admin/catty-reminders-app/venv/bin

[Install]
WantedBy=multi-user.target
